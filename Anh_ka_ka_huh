RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local camera = Workspace.CurrentCamera
    if Config.FlyEnabled and char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") and camera then
        local hrp = char.HumanoidRootPart
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local bv = hrp:FindFirstChild("Anhkaka_FlyVelocity")
        local bg = hrp:FindFirstChild("Anhkaka_FlyGyro")
        if bv and bg then
            bg.CFrame = camera.CFrame
            local moveDir = Vector3.zero
            if humanoid.MoveDirection.Magnitude > 0 then
                moveDir = Vector3.new(humanoid.MoveDirection.X, 0, humanoid.MoveDirection.Z)
            end
            if FlyDirection.Up then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if FlyDirection.Down then moveDir = moveDir - Vector3.new(0, 1, 0) end
            bv.Velocity = moveDir * Config.FlySpeed
        end
    end
end)
